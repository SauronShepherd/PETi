    "red_flags": {"type": "array", "items": {"type": "object"}},
    "recommended_actions": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence_quality": {"type": "object"},
    "safety_state": {"enum": ["CLEAR", "REVIEW", "URGENT", "INSUFFICIENT_EVIDENCE"]},
